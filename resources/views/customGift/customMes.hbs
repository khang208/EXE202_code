                        <div class="card m-2" style="width: 150px;" onclick="selectTemplate('template1')">
                            <img src="https://i.ytimg.com/vi/jRnBvlMUvK0/maxresdefault.jpg"
                                class="card-img-top selected-template" id="template1" alt="Mẫu thư 1">

                        </div>
                        <div class="card m-2" style="width: 160px;" onclick="selectTemplate('template2')">
                            <img src="https://i.ytimg.com/vi/jRnBvlMUvK0/maxresdefault.jpg"
                                class="card-img-top selected-template" id="template2" alt="Mẫu thư 2">

                        </div>
                        <div class="card m-2" style="width: 170px;" onclick="selectTemplate('template3')">
                            <img src="https://i.ytimg.com/vi/jRnBvlMUvK0/maxresdefault.jpg"
                                class="card-img-top selected-template" id="template3" alt="Mẫu thư 3">
                        </div>
                        <div class="card m-2" style="width: 150px;" onclick="selectTemplate('template4')">
                            <img src="https://i.ytimg.com/vi/jRnBvlMUvK0/maxresdefault.jpg"
                                class="card-img-top selected-template" id="template4" alt="Mẫu thư 4">

                        </div>

                    </div>



                    {{!-- --}}


                </div>
            </div>

            <!-- Ô nhập tin nhắn cá nhân -->
            <textarea class="form-control custom-message" rows="4" id="personal-message"
                placeholder="Viết tin nhắn của bạn ở đây..."></textarea>

            <div class="text-center mt-3">
                <a href="/custom-gifts/box">
                    <button class="btn btn-secondary next" onclick="goToStep(2)">Bước trước</button>

                </a>
               
                    <button class="btn btn-success next" onclick="showConfirmation()">Gửi quà tặng</button>
                   
 


            </div>
        </div>

 

    </div>
</div>

 


<!-- Modal Xác nhận -->
<div class="modal" id="confirmationModal" >
   
        <div class="modal-content">
             
                <h5 class="modal-title" id="confirmationModalLabel">🎁 Gửi quà tặng!</h5>
              
          
            
            
                <div id="modal-message">
                    <p><strong>Sản phẩm đã chọn:</strong></p>
                    <ul id="selected-products-list"></ul>

                    <p><strong>Hộp quà:</strong> <span id="selected-box">Chưa chọn</span></p>
                    <p><strong>Thiệp:</strong> <span id="selected-card">Chưa chọn</span></p>
                    <p><strong>Tin nhắn cá nhân:</strong> <span id="selected-message">Không có</span></p>
                     <p><strong>Mẫu thiệp đã chọn:</strong></p>
                    <img id="selected-card" src="https://i.ytimg.com/vi/jRnBvlMUvK0/maxresdefault.jpg" alt="Thiệp đã chọn" style="width: 150px; border: 1px solid #ddd;">
                   
                    <p><strong> <br>Tổng số tiền:</strong> <span id="total-price">0 VND</span></p>
                </div>
             
            
 
                <button type="button"   data-dismiss="modal">Đóng</button>
                <button   id="add-to-cart-btn">Thêm vào giỏ hàng</button>
            
         
    </div>
</div>

  


<script>
    function showConfirmation() {
        let modal = new bootstrap.Modal(document.getElementById('confirmationModal'));
         
        modal.show();
    }

    
</script>


